pipeline {
  agent any

  stages {
    stage('Build Docker Image') {
      steps {
        sh 'docker build -t todo .'
      }
    }

    stage('Deploy Container') {
      steps {
        sh 'docker rm -f todoapp1 || true'
        sh 'docker run -d --name todoapp2 -p 8080:8002 todo'
      }
    }
  }
}
