pipeline {
  agent any

  stages {

    stage('Build') {
      agent {
        docker { 
          image 'python:3.10'
        }
      }
      steps {
        sh """
          pip install django
          python manage.py migrate --noinput
        """
      }
    }

    stage('Deploy') {
      steps {
        sh """
          docker build -t todo:latest .
          docker stop todo || true
          docker rm todo || true
          docker run -d --name todo -p 8000:8000 todo:latest
        """
      }
    }

  }
}
